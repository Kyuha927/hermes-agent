# Execution is fail-closed until explicitly enabled.
LIN3D_ENABLE_EXECUTION=0
LIN3D_ENABLE_ROUTING_WRITES=0

LIN3D_BENCH_STATE_DIR=/Users/macpro/.hermes/lin3d-flash-benchmark
LIN3D_ALLOWED_ROOTS=/Users/macpro/Documents
LIN3D_MAX_WORKERS=8
LIN3D_MAX_SNAPSHOT_BYTES=2147483648

LIN3D_CONTROLLER_MODEL=gpt-5.6-sol
LIN3D_FLASH_MODEL='Gemini 3.8 Flash (High)'
LIN3D_JUDGE_MODEL=gpt-5.6-pro

# JSON arrays or shell-like strings are accepted. No user tool input may override these.
LIN3D_CODEX_COMMAND='["codex"]'
LIN3D_AGY_COMMAND='["agy"]'
LIN3D_WORKER_BACKEND=agy
LIN3D_AGY_EFFORT=high
LIN3D_AGY_SANDBOX=1
LIN3D_AGY_SETTINGS_PATH=/Users/macpro/.gemini/antigravity-cli/settings.json

LIN3D_CONTROLLER_TIMEOUT_SECONDS=7200
LIN3D_WORKER_TIMEOUT_SECONDS=900
LIN3D_MCP_HOST=127.0.0.1
LIN3D_MCP_PORT=8765
